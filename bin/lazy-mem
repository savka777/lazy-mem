#!/usr/bin/env sh
set -eu

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
MEMORY_REPO="$(cd "$SCRIPT_DIR/.." && pwd)"

usage() {
  cat <<'EOF'
Usage:
  lazy-mem attach [project_path] [--id project-id]
  lazy-mem help
  lazy-mem --help
  lazy-mem -h
EOF
}

die() {
  echo "lazy-mem: $*" >&2
  echo >&2
  usage >&2
  exit 1
}

slugify() {
  printf '%s' "$1" |
    tr '[:upper:]' '[:lower:]' |
    sed 's/[^a-z0-9][^a-z0-9]*/-/g; s/^-//; s/-$//'
}

validate_project_id() {
  if ! printf '%s' "$1" | grep -E '^[a-z0-9]([a-z0-9]|-[a-z0-9])*$' >/dev/null 2>&1; then
    die "invalid project id: $1"
  fi
}

yaml_quote() {
  escaped=$(printf '%s' "$1" | sed "s/'/''/g")
  printf "'%s'" "$escaped"
}

yaml_scalar() {
  if printf '%s' "$1" | grep -E '^[-._/A-Za-z0-9]+$' >/dev/null 2>&1; then
    printf '%s' "$1"
  else
    yaml_quote "$1"
  fi
}

sed_escape_replacement() {
  printf '%s' "$1" | sed 's/[\\&|]/\\&/g'
}

write_pointer() {
  pointer_file=$1
  project_id=$2
  memory_repo_value=$(sed_escape_replacement "$(yaml_scalar "$MEMORY_REPO")")
  project_id_value=$(sed_escape_replacement "$(yaml_scalar "$project_id")")

  sed \
    -e "s|__MEMORY_REPO__|$memory_repo_value|g" \
    -e "s|__PROJECT_ID__|$project_id_value|g" \
    "$MEMORY_REPO/templates/project-pointer.yaml" >"$pointer_file"
}

write_project_template() {
  template_file=$1
  output_file=$2
  project_id=$3
  project_title=$4
  project_path=$5
  today=$6
  project_id_value=$(sed_escape_replacement "$project_id")
  project_id_yaml=$(sed_escape_replacement "$(yaml_quote "$project_id")")
  project_title_value=$(sed_escape_replacement "$project_title")
  project_title_yaml=$(sed_escape_replacement "$(yaml_quote "$project_title")")
  project_status_title_yaml=$(sed_escape_replacement "$(yaml_quote "$project_title Current Status")")
  project_decisions_title_yaml=$(sed_escape_replacement "$(yaml_quote "$project_title Decisions")")
  project_features_title_yaml=$(sed_escape_replacement "$(yaml_quote "$project_title Features")")
  project_specs_title_yaml=$(sed_escape_replacement "$(yaml_quote "$project_title Specs")")
  project_path_value=$(sed_escape_replacement "$project_path")
  today_yaml=$(sed_escape_replacement "$(yaml_quote "$today")")

  sed \
    -e "s|__PROJECT_ID_YAML__|$project_id_yaml|g" \
    -e "s|__PROJECT_TITLE_YAML__|$project_title_yaml|g" \
    -e "s|__PROJECT_STATUS_TITLE_YAML__|$project_status_title_yaml|g" \
    -e "s|__PROJECT_DECISIONS_TITLE_YAML__|$project_decisions_title_yaml|g" \
    -e "s|__PROJECT_FEATURES_TITLE_YAML__|$project_features_title_yaml|g" \
    -e "s|__PROJECT_SPECS_TITLE_YAML__|$project_specs_title_yaml|g" \
    -e "s|__DATE_YAML__|$today_yaml|g" \
    -e "s|__PROJECT_ID__|$project_id_value|g" \
    -e "s|__PROJECT_TITLE__|$project_title_value|g" \
    -e "s|__PROJECT_PATH__|$project_path_value|g" \
    -e "s|__DATE__|$today|g" \
    "$template_file" >"$output_file"
}

write_project_page() {
  page_file=$1
  project_id=$2
  project_title=$3
  project_path=$4
  today=$(date +%F)

  write_project_template \
    "$MEMORY_REPO/templates/project.md" \
    "$page_file" \
    "$project_id" \
    "$project_title" \
    "$project_path" \
    "$today"
}

write_project_scaffold_file() {
  template_file=$1
  output_file=$2
  project_id=$3
  project_title=$4
  project_path=$5
  today=$6

  if [ ! -f "$output_file" ]; then
    mkdir -p "$(dirname "$output_file")"
    write_project_template "$template_file" "$output_file" "$project_id" "$project_title" "$project_path" "$today"
  fi
}

ensure_project_scaffold() {
  project_id=$1
  project_title=$2
  project_path=$3
  today=$(date +%F)
  project_dir="$MEMORY_REPO/projects/$project_id"

  write_project_scaffold_file \
    "$MEMORY_REPO/templates/project-status-current.md" \
    "$project_dir/status/current.md" \
    "$project_id" \
    "$project_title" \
    "$project_path" \
    "$today"

  write_project_scaffold_file \
    "$MEMORY_REPO/templates/project-decisions-readme.md" \
    "$project_dir/decisions/README.md" \
    "$project_id" \
    "$project_title" \
    "$project_path" \
    "$today"

  write_project_scaffold_file \
    "$MEMORY_REPO/templates/project-features-readme.md" \
    "$project_dir/features/README.md" \
    "$project_id" \
    "$project_title" \
    "$project_path" \
    "$today"

  write_project_scaffold_file \
    "$MEMORY_REPO/templates/project-specs-readme.md" \
    "$project_dir/specs/README.md" \
    "$project_id" \
    "$project_title" \
    "$project_path" \
    "$today"
}

write_agents_md() {
  agents_file=$1
  tmp_file="$agents_file.tmp.$$"
  start_marker='<!-- lazy-mem:start -->'
  end_marker='<!-- lazy-mem:end -->'
  template_file="$MEMORY_REPO/templates/AGENTS.md"

  if [ -f "$agents_file" ]; then
    if grep -F "$start_marker" "$agents_file" >/dev/null 2>&1 &&
      grep -F "$end_marker" "$agents_file" >/dev/null 2>&1; then
      awk -v start="$start_marker" -v end="$end_marker" -v template="$template_file" '
        function print_template() {
          while ((getline line < template) > 0) {
            print line
          }
          close(template)
        }
        $0 == start {
          print_template()
          in_lazy_mem_block = 1
          next
        }
        in_lazy_mem_block && $0 == end {
          in_lazy_mem_block = 0
          next
        }
        !in_lazy_mem_block {
          print
        }
      ' "$agents_file" >"$tmp_file"
    else
      {
        cat "$agents_file"
        printf '\n\n'
        cat "$template_file"
      } >"$tmp_file"
    fi
  else
    cat "$template_file" >"$tmp_file"
  fi

  mv "$tmp_file" "$agents_file"
}

attach() {
  project_path=.
  project_id=

  if [ "$#" -gt 0 ] && [ "$1" != "--id" ]; then
    project_path=$1
    shift
  fi

  while [ "$#" -gt 0 ]; do
    case "$1" in
      --id)
        shift
        [ "$#" -gt 0 ] || die "--id requires a project id"
        project_id=$1
        validate_project_id "$project_id"
        shift
        ;;
      *)
        die "unknown attach argument: $1"
        ;;
    esac
  done

  mkdir -p "$project_path"
  project_abs="$(cd "$project_path" && pwd)"
  project_title=$(basename "$project_abs")

  if [ -z "$project_id" ]; then
    project_id=$(slugify "$project_title")
  fi

  [ -n "$project_id" ] || die "could not derive project id"
  validate_project_id "$project_id"

  pointer_file="$project_abs/.lazy-mem"
  agents_file="$project_abs/AGENTS.md"
  project_page="$MEMORY_REPO/projects/$project_id.md"

  write_pointer "$pointer_file" "$project_id"
  write_agents_md "$agents_file"

  if [ ! -f "$project_page" ]; then
    write_project_page "$project_page" "$project_id" "$project_title" "$project_abs"
  fi
  ensure_project_scaffold "$project_id" "$project_title" "$project_abs"

  echo "Attached Lazy Mem"
  echo "Project id: $project_id"
  echo "Pointer: $pointer_file"
  echo "Agents: $agents_file"
  echo "System: $MEMORY_REPO/SYSTEM.md"
  echo
  echo "Ready: start your agent from this project root."
  echo "Compatible agents will read AGENTS.md, follow .lazy-mem, and load $MEMORY_REPO/SYSTEM.md."
}

case "${1:-help}" in
  attach)
    shift
    attach "$@"
    ;;
  help|--help|-h)
    usage
    ;;
  *)
    die "unknown command: $1"
    ;;
esac
